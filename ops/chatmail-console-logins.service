[Unit]
Description=Export sanitized Chatmail Dovecot login metadata
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=root
ExecStart=/srv/chatmail-console/current/ops/sync_dovecot_logins.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/chatmail-console/data

[Install]
WantedBy=multi-user.target
