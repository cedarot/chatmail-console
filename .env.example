# Copy to .env and set every required value before starting.
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET=
BIND_ADDRESS=127.0.0.1
HOST_PORT=8080
CHATMAIL_MAIL_DIR=
CHATMAIL_MAIL_GID=996
CHATMAIL_ACCESS_LOG_HOST=
CHATMAIL_LOGIN_EVENTS_HOST=
USERS_SOURCE=maildir:/data/mail
LOGINS_SOURCE=docker-json:/data/chatmail.json.log
ACCESS_LOG_SOURCE=/data/access.log
IP_MASKING=true
COOKIE_SECURE=false
RETENTION_HOURS=168
PAGE_SIZE_MAX=50
ACCESS_LOG_MAX_LINES=20000
