# Copy to .env and replace every placeholder before starting.
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET=
BIND_ADDRESS=127.0.0.1
HOST_PORT=8080
CHATMAIL_MAIL_DIR=./demo/mail
CHATMAIL_MAIL_GID=996
CHATMAIL_ACCESS_LOG_HOST=./demo/access.log
CHATMAIL_LOGIN_EVENTS_HOST=./demo/chatmail.json.log
USERS_SOURCE=maildir:/data/mail
LOGINS_SOURCE=docker-json:/data/chatmail.json.log
ACCESS_LOG_SOURCE=/data/access.log
IP_MASKING=true
COOKIE_SECURE=false
RETENTION_HOURS=168
PAGE_SIZE_MAX=50
ACCESS_LOG_MAX_LINES=20000
