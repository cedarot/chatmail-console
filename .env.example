# Copy to .env and replace every placeholder before starting.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters
BIND_ADDRESS=127.0.0.1
HOST_PORT=8080
CHATMAIL_DATA_DIR=./demo
USERS_SOURCE=/data/users.json
LOGINS_SOURCE=/data/logins.json
ACCESS_LOG_SOURCE=/data/access.log
IP_MASKING=true
COOKIE_SECURE=false
RETENTION_HOURS=168
PAGE_SIZE_MAX=50
ACCESS_LOG_MAX_LINES=20000
